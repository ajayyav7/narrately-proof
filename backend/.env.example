# Ollama runs locally on this PC. The model stays on localhost.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
# Moderate context for the PC's 8 GB RAM.
OLLAMA_NUM_CTX=4096

# Existing Narrately Supabase project. Populate locally; never commit backend/.env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only key for the FastAPI worker. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
